# Listen on loopback behind Nginx in production.
SAGUARO_LISTEN=127.0.0.1:9080
SAGUARO_DATA_DIR=/var/lib/saguaro
SAGUARO_ADMIN_USER=admin
SAGUARO_SECURE_COOKIE=true
# Sessions live in PostgreSQL when a DSN is set (production installs do this);
# without it a file store under SAGUARO_DATA_DIR is used (development).
#SAGUARO_DB_DSN=postgres:///saguaro?host=/var/run/postgresql
# Session lifetime in hours (default 8).
#SAGUARO_SESSION_HOURS=8
# Production delivers the admin password via systemd LoadCredential
# (admin-password:/etc/saguaro/bootstrap-admin-password) — no secret here.
# For development only, either of these works:
#SAGUARO_ADMIN_PASSWORD_FILE=/etc/saguaro/bootstrap-admin-password
#SAGUARO_ADMIN_PASSWORD=replace-with-a-long-random-bootstrap-password
# Service APIs used by the control plane (written by the installer):
#SAGUARO_PDNS_API_URL=http://127.0.0.1:8081
#SAGUARO_PDNS_API_KEY=
#SAGUARO_KEA_API_URL=http://127.0.0.1:8000
#SAGUARO_KEA_API_USER=saguaro
#SAGUARO_KEA_API_PASSWORD=
