# Listen on loopback behind Nginx in production.
SAGUARO_LISTEN=127.0.0.1:9080
SAGUARO_DATA_DIR=/var/lib/saguaro
SAGUARO_ADMIN_USER=admin
SAGUARO_SECURE_COOKIE=true
# Sessions live in PostgreSQL when a DSN is set (production installs do this);
# without it a file store under SAGUARO_DATA_DIR is used (development).
#SAGUARO_DB_DSN=postgres:///saguaro?host=/var/run/postgresql
# Session lifetime in hours (default 8).
#SAGUARO_SESSION_HOURS=8
# Production delivers the admin password via systemd LoadCredential
# (admin-password:/etc/saguaro/bootstrap-admin-password) — no secret here.
# For development only, either of these works:
#SAGUARO_ADMIN_PASSWORD_FILE=/etc/saguaro/bootstrap-admin-password
#SAGUARO_ADMIN_PASSWORD=replace-with-a-long-random-bootstrap-password
# Service APIs used by the control plane (written by the installer). Health
# checks probe these endpoints; unset values report as "not-configured".
#SAGUARO_PDNS_API_URL=http://127.0.0.1:8081
#SAGUARO_PDNS_API_KEY=
#SAGUARO_KEA_API_URL=http://127.0.0.1:8000
#SAGUARO_KEA_API_USER=saguaro
#SAGUARO_KEA_API_PASSWORD=
# Kea PostgreSQL backend — the GUI manages host reservations directly in the
# hosts table (Kea reads them per DHCP transaction).
#SAGUARO_KEA_DB_DSN=postgres:///kea?host=/var/run/postgresql
# Resolver liveness probe target (default 127.0.0.1:53).
#SAGUARO_RESOLVER_ADDR=127.0.0.1:53
# Minutes between background health sweeps (default 5).
#SAGUARO_HEALTH_INTERVAL_MIN=5
# Event collector (saguaro-eventd): journald units to follow (comma-separated;
# default covers the appliance services), minimum severity stored in
# PostgreSQL (info|notice|warning|error|critical|security; journald keeps the
# full raw log regardless), and how many monthly partitions to keep.
#SAGUARO_EVENTD_UNITS=
#SAGUARO_EVENTD_MIN_SEVERITY=notice
#SAGUARO_EVENT_RETENTION_MONTHS=6
# AES-256 key file (base64, 32 bytes) for secrets stored by the GUI, e.g. the
# SMTP password. The installer creates /etc/saguaro/secret.key (root:saguaro
# 0640); development auto-creates one under SAGUARO_DATA_DIR.
#SAGUARO_SECRET_KEY_FILE=/etc/saguaro/secret.key
