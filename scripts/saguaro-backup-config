#!/bin/sh
# saguaro-backup-config — root adapter for the backup module (SNA wizard W11).
# Installs the backup env file and schedule, and runs on-demand backups.
# Allow-listed subcommands only; the saguaro user runs these via sudoers.
#
#   apply     install the staged backup.env and the timer schedule
#   run       run a backup now (also used to satisfy a restore-drill test)
#   disable   stop the scheduled backup timer
set -eu

STAGED_ENV=/var/lib/saguaro/staged-backup.env
STAGED_SCHED=/var/lib/saguaro/staged-backup.schedule
ENV=/etc/saguaro/backup.env
DROPDIR=/etc/systemd/system/saguaro-backup.timer.d

[ "$(id -u)" = 0 ] || { echo "must run as root (via sudo)" >&2; exit 1; }

case "${1:-}" in
  apply)
    [ -s "$STAGED_ENV" ] || { echo "no staged backup env at $STAGED_ENV" >&2; exit 1; }
    # The local destination must exist before the sandboxed backup service starts:
    # its ProtectSystem=strict + ReadWritePaths=/var/backups/saguaro namespace setup
    # fails (226/NAMESPACE) if the directory is missing. Create it here so both new
    # and existing installs work regardless of unit reinstalls.
    install -d -m 0700 -o root -g root /var/backups/saguaro
    # backup.env is sourced by the root backup service, so the staged file is
    # a trust boundary: reject anything that is not a plain KEY=<safe value>
    # line. This blocks shell injection ($(...), backticks, ;, spaces, quotes)
    # even if the control-plane process is compromised.
    if grep -qvE '^(#.*|SAGUARO_[A-Z0-9_]+=[A-Za-z0-9._:/@=+-]*)$' "$STAGED_ENV"; then
      echo "staged backup env contains unsafe content; refusing to install" >&2
      exit 1
    fi
    install -m 0640 -o root -g saguaro "$STAGED_ENV" "$ENV"
    rm -f "$STAGED_ENV"
    if [ -s "$STAGED_SCHED" ]; then
      SCHED=$(cat "$STAGED_SCHED")
      # The schedule goes into a systemd drop-in; restrict it to calendar-safe
      # characters so it cannot inject extra unit directives.
      case "$SCHED" in
        *[!A-Za-z0-9\ :*/,-]*) echo "unsafe backup schedule; refusing" >&2; exit 1 ;;
      esac
      install -d -m 0755 "$DROPDIR"
      cat >"$DROPDIR/schedule.conf" <<EOF
[Timer]
OnCalendar=
OnCalendar=$SCHED
EOF
      rm -f "$STAGED_SCHED"
      systemctl daemon-reload
      systemctl enable --now saguaro-backup.timer >/dev/null 2>&1 || true
    fi
    logger -t saguaro-backup-config "backup configuration applied"
    ;;
  run)
    systemctl start saguaro-backup.service
    logger -t saguaro-backup-config "on-demand backup started"
    ;;
  disable)
    systemctl disable --now saguaro-backup.timer 2>/dev/null || true
    logger -t saguaro-backup-config "scheduled backup disabled"
    ;;
  list)
    # List local backup artifacts (name<TAB>bytes<TAB>mtime-epoch). Read-only.
    cd /var/backups/saguaro 2>/dev/null || exit 0
    for f in saguaro-*.age saguaro-*.sha256; do
      [ -f "$f" ] || continue
      printf '%s\t%s\t%s\n' "$f" "$(stat -c %s "$f")" "$(stat -c %Y "$f")"
    done
    ;;
  get)
    # Stream one local backup artifact to stdout for download. The archives are
    # age-encrypted, so this exposes only ciphertext. Strict filename charset +
    # a fixed directory prevents path traversal.
    f="${2:-}"
    echo "$f" | grep -qE '^saguaro-[A-Za-z0-9._-]+\.(age|sha256)$' || { echo "invalid backup filename" >&2; exit 1; }
    [ -f "/var/backups/saguaro/$f" ] || { echo "no such backup" >&2; exit 1; }
    cat "/var/backups/saguaro/$f"
    ;;
  restore)
    # Disaster recovery: decrypt a local archive with the on-box age key and put
    # the configuration + databases back. Intended to run on a freshly-installed
    # box (the operator first restores their saved backup.agekey and drops the
    # archive into /var/backups/saguaro). Strict filename charset; fixed dir.
    # Exclusive lock: two overlapping restores would tear each other's files
    # apart (the detached saguaro restart from the first kills the second one
    # mid-extract). The lock dies with this process, so no stale-lock cleanup.
    exec 9>/run/saguaro-restore.lock
    flock -n 9 || { echo "another restore is already running -- wait for it to finish" >&2; exit 1; }
    f="${2:-}"
    echo "$f" | grep -qE '^saguaro-[A-Za-z0-9._-]+\.tar\.gz\.age$' || { echo "invalid archive filename" >&2; exit 1; }
    SRC="/var/backups/saguaro/$f"
    [ -f "$SRC" ] || { echo "no such backup archive at $SRC" >&2; exit 1; }
    [ -s /etc/saguaro/backup.agekey ] || { echo "decryption key /etc/saguaro/backup.agekey is missing (restore your saved key first)" >&2; exit 1; }
    command -v age >/dev/null || { echo "age is not installed" >&2; exit 1; }
    RWORK=$(mktemp -d); trap 'rm -rf -- "$RWORK"' EXIT
    if ! age -d -i /etc/saguaro/backup.agekey "$SRC" 2>/dev/null | tar -C "$RWORK" -xzf - 2>/dev/null; then
      echo "decrypt/extract failed -- wrong key for this archive, or the archive is corrupt" >&2; exit 1
    fi
    [ -d "$RWORK/etc/saguaro" ] || { echo "this does not look like a Saguaro backup (no etc/saguaro inside)" >&2; exit 1; }
    # Restore the config trees. backup.agekey was excluded from the archive, so the
    # current decryption key is preserved.
    for d in etc/saguaro etc/kea etc/unbound etc/powerdns etc/nginx etc/netplan etc/systemd/network var/lib/saguaro; do
      [ -d "$RWORK/$d" ] && { install -d "/$d" 2>/dev/null || true; cp -a "$RWORK/$d/." "/$d/" 2>/dev/null || true; }
    done
    [ -f "$RWORK/etc/nftables.conf" ] && cp -a "$RWORK/etc/nftables.conf" /etc/nftables.conf
    [ -f "$RWORK/etc/sysctl.d/99-saguaro-forward.conf" ] && cp -a "$RWORK/etc/sysctl.d/99-saguaro-forward.conf" /etc/sysctl.d/99-saguaro-forward.conf
    # Restore the databases (dumps were taken with --clean --if-exists).
    if [ -d "$RWORK/pgsql" ] && command -v psql >/dev/null; then
      for db in saguaro kea pdns; do
        if [ -f "$RWORK/pgsql/$db.sql" ]; then
          runuser -u postgres -- psql -q -d "$db" -f "$RWORK/pgsql/$db.sql" >/dev/null 2>&1 || true
        fi
      done
    fi
    # Also restore the internal CA from its companion archive (same timestamp) so
    # internally-issued certificates stay valid after a rebuild. Best-effort: a
    # missing or undecryptable CA archive does not fail the whole restore.
    CA_SRC="/var/backups/saguaro/saguaro-ca-${f#saguaro-}"
    if [ -f "$CA_SRC" ]; then
      # Stop the CA before extracting over its live Badger database — unpacking
      # under a running step-ca can leave a torn on-disk state it cannot open.
      systemctl stop step-ca-saguaro 2>/dev/null || true
      if age -d -i /etc/saguaro/backup.agekey "$CA_SRC" 2>/dev/null | tar -C / -xzf - etc/step-ca 2>/dev/null; then
        systemctl restart step-ca-saguaro 2>/dev/null || true
        logger -t saguaro-backup-config "restored internal CA from $(basename "$CA_SRC")"
      else
        # Extraction did not happen, so the old CA state is intact — bring it back up.
        systemctl start step-ca-saguaro 2>/dev/null || true
        echo "note: CA archive present but could not be decrypted (separate CA key?) -- skipped" >&2
      fi
    fi
    # Bring the restored configuration into effect.
    systemctl daemon-reload 2>/dev/null || true
    sysctl -q --system 2>/dev/null || true
    nft -f /etc/nftables.conf 2>/dev/null || true
    netplan apply 2>/dev/null || true
    systemctl restart kea-dhcp4-server unbound pdns nginx saguaro-eventd 2>/dev/null || true
    logger -t saguaro-backup-config "restored configuration + databases from $f"
    echo "restore complete from $f"
    # Restart the control plane itself DETACHED: this adapter is a child of the
    # saguaro process, so an inline `systemctl restart saguaro` would kill this very
    # script (and could cut the API response) mid-restart. Hand it to a transient
    # unit that survives our exit -- same pattern the self-update uses.
    systemd-run --on-active=2 --unit=saguaro-restore-restart systemctl restart saguaro >/dev/null 2>&1 || true
    ;;
  get-key)
    # Output the age DECRYPTION key so the operator can store the DR kit (archive
    # + key) off-box from the GUI. Sensitive: the control plane gates this to admin
    # and audits it. The key decrypts every backup.
    [ -s /etc/saguaro/backup.agekey ] || { echo "no backup decryption key on this device" >&2; exit 1; }
    cat /etc/saguaro/backup.agekey
    ;;
  set-key)
    # Import a saved age decryption key (disaster recovery on a fresh device) and
    # re-derive the public recipient so future backups use the same key.
    STAGED_KEY=/var/lib/saguaro/staged-backup.agekey
    [ -s "$STAGED_KEY" ] || { echo "no staged key at $STAGED_KEY" >&2; exit 1; }
    grep -qE '^AGE-SECRET-KEY-1[0-9A-Z]+$' "$STAGED_KEY" || { echo "not a valid age secret key" >&2; exit 1; }
    command -v age-keygen >/dev/null || { echo "age-keygen not installed" >&2; exit 1; }
    install -m 0600 -o root -g root "$STAGED_KEY" /etc/saguaro/backup.agekey
    rm -f "$STAGED_KEY"
    age-keygen -y /etc/saguaro/backup.agekey >/etc/saguaro/backup-recipient.txt 2>/dev/null || { echo "could not derive recipient from the key" >&2; exit 1; }
    chmod 0644 /etc/saguaro/backup-recipient.txt
    logger -t saguaro-backup-config "backup decryption key imported"
    echo "key imported"
    ;;
  *)
    echo "usage: saguaro-backup-config apply|run|disable|list|get|restore|get-key|set-key" >&2
    exit 2
    ;;
esac
