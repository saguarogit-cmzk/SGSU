#!/bin/sh
# saguaro-wan — root adapter for the Multi-WAN module (SNA wizard W12).
# Installs the uplink spec and runs the failover health-check loop that
# rebuilds the weighted multipath default route as uplinks go up/down.
# Allow-listed subcommands only; the saguaro user runs these via sudoers.
#
#   apply       install the staged spec, build the initial default route and
#               (re)start the failover checker
#   check       one health-check pass (invoked by saguaro-wan-check.timer)
#   disable     stop the failover checker (leaves the current route in place)
set -eu

STAGED=/var/lib/saguaro/staged-wan.spec
SPEC=/etc/saguaro/wan.spec
STAGED_MODE=/var/lib/saguaro/staged-wan.mode
MODE_FILE=/etc/saguaro/wan.mode
PBR_PREF=20000
FLAG=/run/saguaro/wan-pending
TIMER_UNIT=saguaro-wan-rollback

[ "$(id -u)" = 0 ] || { echo "must run as root (via sudo)" >&2; exit 1; }

# cleanup_pbr removes the Saguaro-managed policy rules and per-uplink tables.
cleanup_pbr() {
  n=0
  while [ "$n" -lt 96 ]; do
    ip rule del pref $((PBR_PREF + n)) 2>/dev/null || true
    n=$((n + 1))
  done
  t=100
  while [ "$t" -lt 164 ]; do
    ip route flush table "$t" 2>/dev/null || true
    t=$((t + 1))
  done
}

# setup_pbr builds one routing table per uplink (default via that uplink) and
# `ip rule` entries: source-based (traffic from the uplink's own IP) and
# fwmark-based (replies marked by the nft mangle chain) so each WAN's traffic
# stays symmetric. Table = 100+index, mark = index+1.
setup_pbr() {
  cleanup_pbr
  # Snapshot the directly-connected (on-link) subnet routes. Each per-uplink
  # table must carry these so traffic to local subnets -- LAN clients, the other
  # WAN, and the box's own management replies -- stays on-link instead of being
  # sent to the WAN gateway. Without them a `from <wan-ip>` rule routes management
  # replies to the gateway, which does not hairpin, and cuts the admin off.
  connected=$(ip -4 route show table main scope link proto kernel 2>/dev/null)
  i=0
  while read -r name iface gw weight hc; do
    case "$name" in ''|\#*) continue ;; esac
    tbl=$((100 + i))
    mark=$((i + 1))
    ip route replace default via "$gw" dev "$iface" table "$tbl" 2>/dev/null || true
    # Keep local subnets reachable directly from within this uplink's table.
    printf '%s\n' "$connected" | while IFS= read -r cr; do
      [ -n "$cr" ] && ip route add table "$tbl" $cr 2>/dev/null || true
    done
    src=$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)
    if [ -n "$src" ]; then
      ip rule add from "$src" lookup "$tbl" pref $((PBR_PREF + i)) 2>/dev/null || true
    fi
    ip rule add fwmark "$mark" lookup "$tbl" pref $((PBR_PREF + 48 + i)) 2>/dev/null || true
    i=$((i + 1))
  done <"$SPEC"
  logger -t saguaro-wan "pbr rules installed ($i uplinks)"
}

# uplink_healthy pings HC via IFACE; empty/"-" HC or missing ping => assumed up.
uplink_healthy() {
  _iface=$1; _hc=$2
  [ "$_hc" = "-" ] && return 0
  command -v ping >/dev/null 2>&1 || return 0
  ping -c1 -W2 -I "$_iface" "$_hc" >/dev/null 2>&1
}

build_route() {
  mode=loadbalance
  [ -s "$MODE_FILE" ] && mode=$(cat "$MODE_FILE")
  if [ "$mode" = failover ]; then
    # Failover: exactly one active uplink — the FIRST healthy one in spec order
    # (top of the file = primary). Single-nexthop default route, no weight.
    while read -r name iface gw weight hc; do
      case "$name" in ''|\#*) continue ;; esac
      if uplink_healthy "$iface" "$hc"; then
        ip route replace default via "$gw" dev "$iface"
        logger -t saguaro-wan "failover: active uplink $name ($iface via $gw)"
        return 0
      fi
    done <"$SPEC"
    logger -t saguaro-wan "failover: all uplinks down"
    return 1
  fi
  args="route replace default"
  up=0
  while read -r name iface gw weight hc; do
    case "$name" in ''|\#*) continue ;; esac
    if uplink_healthy "$iface" "$hc"; then
      args="$args nexthop via $gw dev $iface weight $weight"
      up=$((up+1))
    fi
  done <"$SPEC"
  [ "$up" -gt 0 ] || { logger -t saguaro-wan "all uplinks down"; return 1; }
  # shellcheck disable=SC2086
  ip $args
}

case "${1:-}" in
  apply)
    [ -s "$STAGED" ] || { echo "no staged spec at $STAGED" >&2; exit 1; }
    # The spec fields flow into `ip` and `ping` arguments; restrict them to a
    # safe charset so a compromised control plane cannot smuggle extra tokens.
    if grep -qvE '^(#.*|[A-Za-z0-9._-]+ [A-Za-z0-9._-]+ [0-9.]+ [0-9]+ ([0-9.]+|-))$' "$STAGED"; then
      echo "staged WAN spec contains unsafe content; refusing to install" >&2
      exit 1
    fi
    install -m 0644 -o root -g root "$STAGED" "$SPEC"
    rm -f "$STAGED"
    # Install the routing mode (loadbalance|failover). Strict single-word guard so
    # nothing but those two values can reach build_route's control flow.
    if [ -f "$STAGED_MODE" ]; then
      grep -qxE '(failover|loadbalance)' "$STAGED_MODE" || { echo "staged WAN mode invalid" >&2; exit 1; }
      install -m 0644 -o root -g root "$STAGED_MODE" "$MODE_FILE"
      rm -f "$STAGED_MODE"
    else
      printf 'loadbalance\n' >"$MODE_FILE"
    fi
    printf 'net.ipv4.ip_forward=1\n' >/etc/sysctl.d/99-saguaro-forward.conf
    sysctl -q -w net.ipv4.ip_forward=1
    build_route || true
    setup_pbr
    systemctl enable --now saguaro-wan-check.timer >/dev/null 2>&1 || true
    # Arm an auto-rollback: a routing change can cut the admin off (a bad gateway,
    # or a policy-routing edge case). If it is not confirmed within 120 s the
    # config is torn down and the previous routes restored -- the same safety the
    # firewall apply has, learned the hard way.
    install -d -m 0755 /run/saguaro 2>/dev/null || true
    : >"$FLAG"
    systemctl stop "$TIMER_UNIT.timer" 2>/dev/null || true
    systemd-run --unit="$TIMER_UNIT" --on-active=120 --timer-property=AccuracySec=1s \
      /usr/sbin/saguaro-wan rollback-if-pending >/dev/null 2>&1 || true
    logger -t saguaro-wan "multi-WAN applied; auto-rollback in 120 s unless confirmed"
    ;;
  confirm)
    rm -f "$FLAG"
    systemctl stop "$TIMER_UNIT.timer" 2>/dev/null || true
    logger -t saguaro-wan "multi-WAN confirmed"
    ;;
  check)
    [ -s "$SPEC" ] || exit 0
    build_route || true
    ;;
  disable)
    systemctl disable --now saguaro-wan-check.timer 2>/dev/null || true
    rm -f "$FLAG"
    systemctl stop "$TIMER_UNIT.timer" 2>/dev/null || true
    cleanup_pbr
    rm -f "$SPEC" "$MODE_FILE"
    # Restore the addresses' own DHCP/static routes that the multipath default
    # replaced, so egress returns to normal immediately.
    networkctl reload >/dev/null 2>&1 || true
    logger -t saguaro-wan "multi-WAN disabled"
    ;;
  rollback-if-pending)
    [ -e "$FLAG" ] || exit 0
    systemctl disable --now saguaro-wan-check.timer 2>/dev/null || true
    rm -f "$FLAG"
    cleanup_pbr
    rm -f "$SPEC" "$MODE_FILE"
    networkctl reload >/dev/null 2>&1 || true
    logger -t saguaro-wan "multi-WAN auto-rolled back (unconfirmed)"
    ;;
  *)
    echo "usage: saguaro-wan apply|confirm|check|disable|rollback-if-pending" >&2
    exit 2
    ;;
esac
