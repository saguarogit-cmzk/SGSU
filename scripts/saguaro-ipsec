#!/bin/sh
# saguaro-ipsec — root adapter for the IPsec IKEv2 site-to-site module.
# Installs the generated swanctl.conf and loads it into strongSwan (charon).
# Allow-listed subcommands only; the saguaro user runs these via sudoers.
#
#   apply    install the staged swanctl.conf, enable forwarding, (re)start
#            strongSwan and load the connections; failure restores the backup
#   disable  unload connections and stop strongSwan
set -eu

STAGED=/var/lib/saguaro/staged-swanctl.conf
ACTIVE=/etc/swanctl/swanctl.conf
BACKUP=/run/saguaro/swanctl-backup.conf
STAGED_CREDS=/var/lib/saguaro/staged-swanctl-creds

[ "$(id -u)" = 0 ] || { echo "must run as root (via sudo)" >&2; exit 1; }

# The daemon swanctl talks to over vici is charon. On Ubuntu's strongswan
# metapackage that charon runs under strongswan-starter; the charon-systemd
# alternative runs under strongswan. Prefer whichever unit is installed,
# starter first (the Ubuntu default), so we drive the unit that owns vici.
svc_name() {
  for u in strongswan-starter strongswan; do
    if systemctl cat "$u" >/dev/null 2>&1; then echo "$u"; return; fi
  done
  echo strongswan
}

# wait_vici blocks until charon actually answers on vici (up to ~15s). It
# probes with `swanctl --stats` rather than the socket file, which can linger
# stale after a stop and would otherwise race a just-started charon.
wait_vici() {
  i=0
  while [ "$i" -lt 30 ]; do
    swanctl --stats >/dev/null 2>&1 && return 0
    i=$((i + 1)); sleep 0.5
  done
  return 1
}

# install_creds replaces the Saguaro-managed certificate material for cert-auth
# connections from the staged directory; other credentials are left untouched.
install_creds() {
  install -d -m 0755 /etc/swanctl/x509 /etc/swanctl/x509ca
  install -d -m 0700 /etc/swanctl/private
  rm -f /etc/swanctl/x509/saguaro-*.pem /etc/swanctl/private/saguaro-*.pem /etc/swanctl/x509ca/saguaro-*.pem
  [ -d "$STAGED_CREDS" ] || return 0
  for f in "$STAGED_CREDS"/*; do
    [ -e "$f" ] || continue
    base=$(basename "$f")
    conn=${base%.*.pem}
    echo "$conn" | grep -Eq '^[a-z0-9-]+$' || continue
    case "$base" in
      *.cert.pem) install -m 0644 -o root -g root "$f" "/etc/swanctl/x509/saguaro-$conn.pem" ;;
      *.key.pem)  install -m 0600 -o root -g root "$f" "/etc/swanctl/private/saguaro-$conn.pem" ;;
      *.ca.pem)   install -m 0644 -o root -g root "$f" "/etc/swanctl/x509ca/saguaro-$conn-ca.pem" ;;
    esac
  done
  rm -rf "$STAGED_CREDS"
}

case "${1:-}" in
  apply)
    [ -s "$STAGED" ] || { echo "no staged config at $STAGED" >&2; exit 1; }
    command -v swanctl >/dev/null || { echo "strongswan-swanctl is not installed" >&2; exit 1; }
    install -d -m 0700 /etc/swanctl
    install -d -m 0755 /run/saguaro
    if [ -e "$ACTIVE" ]; then cp -p "$ACTIVE" "$BACKUP"; else : >"$BACKUP"; fi
    install -m 0600 -o root -g root "$STAGED" "$ACTIVE"
    # The staged copy holds the preshared keys; remove it once installed.
    rm -f "$STAGED"
    printf 'net.ipv4.ip_forward=1\n' >/etc/sysctl.d/99-saguaro-forward.conf
    sysctl -q -w net.ipv4.ip_forward=1
    SVC=$(svc_name)
    systemctl enable "$SVC" >/dev/null 2>&1 || true
    # Start (not restart) so an already-running charon keeps live tunnels;
    # swanctl --load-all reconciles the configuration into it.
    install_creds
    systemctl start "$SVC"
    wait_vici || { echo "charon vici socket did not appear" >&2; exit 1; }
    swanctl --load-creds >/dev/null 2>&1 || true
    if ! swanctl --load-all; then
      if [ -s "$BACKUP" ]; then
        install -m 0600 -o root -g root "$BACKUP" "$ACTIVE"
      else
        rm -f "$ACTIVE"
      fi
      swanctl --load-all >/dev/null 2>&1 || true
      echo "swanctl failed to load the new configuration; previous state restored" >&2
      exit 1
    fi
    swanctl --load-creds >/dev/null 2>&1 || true
    logger -t saguaro-ipsec "ipsec configuration applied"
    ;;
  disable)
    rm -f "$ACTIVE"
    # Loading an absent/empty config unloads the connections from charon.
    swanctl --load-all >/dev/null 2>&1 || true
    SVC=$(svc_name)
    systemctl disable --now "$SVC" 2>/dev/null || true
    logger -t saguaro-ipsec "ipsec disabled"
    ;;
  *)
    echo "usage: saguaro-ipsec apply|disable" >&2
    exit 2
    ;;
esac
