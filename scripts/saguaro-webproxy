#!/bin/sh
# saguaro-webproxy — root adapter for the caching/filtering web proxy: Squid
# (cache + LAN access) with optional e2guardian URL filtering chained in front.
# Allow-listed subcommands only.
#
#   apply PORT FILTER   install the staged Squid drop-in and (when FILTER=1)
#                       the e2guardian banned/exception lists, then (re)start
#   disable             stop and disable Squid and e2guardian
set -eu

STAGED_SQUID=/var/lib/saguaro/staged-squid.conf
STAGED_BANNED=/var/lib/saguaro/staged-e2g-banned
STAGED_EXC=/var/lib/saguaro/staged-e2g-exceptions
SQUID_DROPIN=/etc/squid/conf.d/saguaro.conf
SQUID_BACKUP=/run/saguaro/squid-dropin-backup.conf
E2G_DIR=/etc/e2guardian
E2G_LISTS="$E2G_DIR/lists"
BUMP_DIR=/etc/squid/ssl_cert
BUMP_CERT="$BUMP_DIR/saguaro-bump-ca.pem"
BUMP_KEY="$BUMP_DIR/saguaro-bump-ca.key"
SSL_DB=/var/lib/squid/ssl_db
CA_PUBLISH=/var/lib/saguaro/webproxy-bump-ca.crt

[ "$(id -u)" = 0 ] || { echo "must run as root (via sudo)" >&2; exit 1; }

ensure_include() { # file marker-line
  grep -qF "$2" "$1" 2>/dev/null || printf '%s\n' "$2" >>"$1"
}

# validate_squid enforces a directive allow-list on the drop-in BEFORE Squid
# parses it. /var/lib/saguaro is writable by the unprivileged saguaro user, and
# `squid -k parse` accepts directives that name helper programs
# (url_rewrite_program, external_acl_type, auth_param ... program,
# logfile_daemon) or pull in arbitrary files (include) — the same privilege
# boundary validate_wg and validate_swanctl defend in the VPN adapters. The
# generator emits only these four directives; sslcrtd_program is legitimate but
# pinned to its exact generated form so no other helper path can appear.
validate_squid() {
  while IFS= read -r line || [ -n "$line" ]; do
    l=$(printf '%s' "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    case "$l" in ''|'#'*) continue ;; esac
    key=$(printf '%s' "$l" | awk '{print tolower($1)}')
    case "$key" in
      acl|http_access|http_port|ssl_bump) ;;
      sslcrtd_program)
        [ "$l" = "sslcrtd_program /usr/lib/squid/security_file_certgen -s /var/lib/squid/ssl_db -M 4MB" ] || {
          echo "refusing squid config: sslcrtd_program must be the fixed generated helper" >&2; return 1; } ;;
      *) echo "refusing squid config: disallowed directive: $line" >&2; return 1 ;;
    esac
  done < "$1"
  return 0
}

# validate_list keeps the e2guardian banned/exception lists to plain domain
# entries: an `.Include<...>` line inside a list would pull in any file.
validate_list() {
  while IFS= read -r line || [ -n "$line" ]; do
    l=$(printf '%s' "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    case "$l" in ''|'#'*) continue ;; esac
    printf '%s' "$l" | grep -Eq '^[A-Za-z0-9.*_-]+$' || {
      echo "refusing e2guardian list $1: unexpected entry: $line" >&2; return 1; }
  done < "$1"
  return 0
}

case "${1:-}" in
  bump-ca)
    # Generate the SSL-bump CA (once) and initialise Squid's cert-generator DB,
    # then publish the PUBLIC CA cert where the control plane can serve it for
    # download. The private key never leaves the box.
    command -v squid >/dev/null || { echo "squid is not installed" >&2; exit 1; }
    command -v openssl >/dev/null || { echo "openssl is not installed" >&2; exit 1; }
    install -d -m 0755 -o root -g proxy "$BUMP_DIR" 2>/dev/null || install -d -m 0755 "$BUMP_DIR"
    if [ ! -s "$BUMP_KEY" ] || [ ! -s "$BUMP_CERT" ]; then
      openssl req -new -newkey rsa:2048 -sha256 -days 3650 -nodes -x509 \
        -keyout "$BUMP_KEY" -out "$BUMP_CERT" \
        -subj "/O=Saguaro/CN=Saguaro Web Proxy CA" \
        -addext "basicConstraints=critical,CA:TRUE" \
        -addext "keyUsage=critical,keyCertSign,cRLSign" >/dev/null 2>&1 \
        || { echo "openssl failed to generate the SSL-bump CA" >&2; exit 1; }
    fi
    chown root:proxy "$BUMP_KEY" "$BUMP_CERT" 2>/dev/null || true
    chmod 0440 "$BUMP_KEY"; chmod 0444 "$BUMP_CERT"
    CERTGEN=/usr/lib/squid/security_file_certgen
    [ -x "$CERTGEN" ] || CERTGEN=/usr/lib/squid/ssl_crtd
    if [ ! -d "$SSL_DB" ] && [ -x "$CERTGEN" ]; then
      "$CERTGEN" -c -s "$SSL_DB" -M 4MB >/dev/null 2>&1 || true
    fi
    chown -R proxy:proxy "$SSL_DB" 2>/dev/null || true
    install -m 0644 -o root -g saguaro "$BUMP_CERT" "$CA_PUBLISH" 2>/dev/null || cp "$BUMP_CERT" "$CA_PUBLISH"
    logger -t saguaro-webproxy "ssl-bump CA ensured"
    ;;
  apply)
    PORT="${2:-8080}"
    FILTER="${3:-0}"
    echo "$PORT" | grep -Eq '^[0-9]{1,5}$' || { echo "invalid port" >&2; exit 1; }
    [ "$FILTER" = 0 ] || [ "$FILTER" = 1 ] || { echo "invalid filter flag" >&2; exit 1; }
    command -v squid >/dev/null || { echo "squid is not installed" >&2; exit 1; }
    [ -s "$STAGED_SQUID" ] || { echo "no staged squid config" >&2; exit 1; }
    install -d -m 0755 /etc/squid/conf.d
    # Snapshot the live drop-in so a rejected config restores what was working
    # instead of leaving the proxy with no Saguaro configuration at all.
    install -d -m 0755 /run/saguaro
    if [ -e "$SQUID_DROPIN" ]; then cp -p "$SQUID_DROPIN" "$SQUID_BACKUP"; else rm -f "$SQUID_BACKUP"; fi
    install -m 0644 -o root -g root "$STAGED_SQUID" "$SQUID_DROPIN"
    rm -f "$STAGED_SQUID"
    # Validate the DESTINATION, not the staged file (SR2), then let Squid parse.
    if ! validate_squid "$SQUID_DROPIN" || ! squid -k parse >/dev/null 2>&1; then
      if [ -s "$SQUID_BACKUP" ]; then
        install -m 0644 -o root -g root "$SQUID_BACKUP" "$SQUID_DROPIN"
      else
        rm -f "$SQUID_DROPIN"
      fi
      echo "squid config refused; previous state restored" >&2
      exit 1
    fi
    systemctl enable squid >/dev/null 2>&1 || true
    systemctl restart squid
    if [ "$FILTER" = 1 ] && command -v e2guardian >/dev/null; then
      install -d -m 0755 "$E2G_LISTS"
      install -m 0644 -o root -g root "$STAGED_BANNED" "$E2G_LISTS/saguaro-banned" 2>/dev/null || : >"$E2G_LISTS/saguaro-banned"
      install -m 0644 -o root -g root "$STAGED_EXC" "$E2G_LISTS/saguaro-exceptions" 2>/dev/null || : >"$E2G_LISTS/saguaro-exceptions"
      for lf in "$E2G_LISTS/saguaro-banned" "$E2G_LISTS/saguaro-exceptions"; do
        validate_list "$lf" || { : >"$lf"; echo "cleared $lf after refusing its content" >&2; exit 1; }
      done
      ensure_include "$E2G_LISTS/bannedsitelist" ".Include<$E2G_LISTS/saguaro-banned>"
      ensure_include "$E2G_LISTS/exceptionsitelist" ".Include<$E2G_LISTS/saguaro-exceptions>"
      # point e2guardian at the client port and the Squid parent
      sed -i "s/^filterport = .*/filterport = $PORT/" "$E2G_DIR/e2guardian.conf" 2>/dev/null || true
      sed -i "s/^proxyport = .*/proxyport = 3128/" "$E2G_DIR/e2guardian.conf" 2>/dev/null || true
      systemctl enable e2guardian >/dev/null 2>&1 || true
      systemctl restart e2guardian || echo "e2guardian restart failed; check config" >&2
    else
      systemctl disable --now e2guardian 2>/dev/null || true
    fi
    rm -f "$STAGED_BANNED" "$STAGED_EXC"
    logger -t saguaro-webproxy "web proxy applied (port $PORT, filter $FILTER)"
    ;;
  disable)
    systemctl disable --now e2guardian 2>/dev/null || true
    systemctl disable --now squid 2>/dev/null || true
    rm -f "$SQUID_DROPIN"
    logger -t saguaro-webproxy "web proxy disabled"
    ;;
  *)
    echo "usage: saguaro-webproxy bump-ca | apply PORT FILTER | disable" >&2
    exit 2
    ;;
esac
