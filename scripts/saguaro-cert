#!/bin/sh
# saguaro-cert — root adapter for the certificates module (SNA wizard W6).
# Issues internal certificates from the appliance Step CA and deploys them.
# Allow-listed subcommands only; the saguaro user runs these via sudoers.
#
#   issue            issue a certificate from the staged request file
#                    (line 1: name, following lines: SANs)
#   renew-all        renew every managed certificate (also run by the
#                    saguaro-cert-renew.timer) and reload nginx
#   remove NAME      delete a managed certificate
#   deploy-gui NAME  install a managed certificate as the GUI TLS cert
set -eu

STAGED=/var/lib/saguaro/staged-cert-request
CERTDIR=/etc/saguaro/certs
CA_URL=https://127.0.0.1:9000
CA_ROOT=/etc/step-ca/certs/root_ca.crt
CA_PASS=/etc/step-ca/password
GUI_CRT=/etc/saguaro/bootstrap-tls.crt
GUI_KEY=/etc/saguaro/bootstrap-tls.key

[ "$(id -u)" = 0 ] || { echo "must run as root (via sudo)" >&2; exit 1; }

valid_name() { echo "$1" | grep -Eq '^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$'; }
valid_san()  { echo "$1" | grep -Eq '^(\*\.)?[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$'; }
# DNS-01 accepts an optional wildcard prefix.
valid_acme_domain() { echo "$1" | grep -Eq '^(\*\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$'; }

SELF=/usr/sbin/saguaro-cert

# pdns_zone_for prints the longest local PowerDNS zone that is a suffix of the
# given domain, so the ACME challenge TXT lands in the right zone.
pdns_zone_for() {
  d="$1"; best=""
  command -v pdnsutil >/dev/null 2>&1 || return 1
  for z in $(pdnsutil list-all-zones 2>/dev/null); do
    z=${z%.}
    if [ "$d" = "$z" ] || [ "${d%.$z}" != "$d" ]; then
      [ ${#z} -gt ${#best} ] && best="$z"
    fi
  done
  [ -n "$best" ] && { echo "$best"; return 0; }
  return 1
}

# rel_challenge prints the _acme-challenge record name relative to its zone.
rel_challenge() {
  d="$1"; z="$2"
  sub=${d%.$z}
  if [ "$sub" = "$d" ]; then echo "_acme-challenge"; else echo "_acme-challenge.$sub"; fi
}

# open80/close80 briefly allow inbound tcp/80 in the main firewall so the ACME
# HTTP-01 challenge can reach certbot --standalone. No-op if the firewall table
# is absent (permissive setup).
open80() {
  nft list chain inet saguaro input >/dev/null 2>&1 || return 0
  nft insert rule inet saguaro input tcp dport 80 accept comment "saguaro-acme" 2>/dev/null || true
}
close80() {
  nft list chain inet saguaro input >/dev/null 2>&1 || return 0
  h=$(nft -a list chain inet saguaro input 2>/dev/null | awk '/saguaro-acme/{print $NF}')
  [ -n "$h" ] && nft delete rule inet saguaro input handle "$h" 2>/dev/null || true
}

# install_acme_hooks wires unattended renewal (certbot.timer): pre/post open and
# close tcp/80, and a per-lineage deploy hook that copies the renewed cert into
# our store and reloads nginx. Uses $NAME/$DOMAIN from the acme case.
install_acme_hooks() {
  install -d -m 0755 /etc/letsencrypt/renewal-hooks/pre /etc/letsencrypt/renewal-hooks/post /etc/letsencrypt/renewal-hooks/deploy
  cat >/etc/letsencrypt/renewal-hooks/pre/saguaro-open80.sh <<'HOOK'
#!/bin/sh
nft list chain inet saguaro input >/dev/null 2>&1 || exit 0
nft insert rule inet saguaro input tcp dport 80 accept comment "saguaro-acme" 2>/dev/null || true
HOOK
  cat >/etc/letsencrypt/renewal-hooks/post/saguaro-close80.sh <<'HOOK'
#!/bin/sh
nft list chain inet saguaro input >/dev/null 2>&1 || exit 0
h=$(nft -a list chain inet saguaro input 2>/dev/null | awk '/saguaro-acme/{print $NF}')
[ -n "$h" ] && nft delete rule inet saguaro input handle "$h" 2>/dev/null || true
HOOK
  cat >"/etc/letsencrypt/renewal-hooks/deploy/saguaro-$NAME.sh" <<HOOK
#!/bin/sh
[ "\$RENEWED_LINEAGE" = "/etc/letsencrypt/live/$NAME" ] || exit 0
install -m 0644 "\$RENEWED_LINEAGE/fullchain.pem" "$CERTDIR/$NAME.crt"
install -m 0600 "\$RENEWED_LINEAGE/privkey.pem" "$CERTDIR/$NAME.key"
nginx -t >/dev/null 2>&1 && systemctl reload nginx || true
HOOK
  chmod 0755 /etc/letsencrypt/renewal-hooks/pre/saguaro-open80.sh \
    /etc/letsencrypt/renewal-hooks/post/saguaro-close80.sh \
    "/etc/letsencrypt/renewal-hooks/deploy/saguaro-$NAME.sh"
}

case "${1:-}" in
  issue)
    [ -s "$STAGED" ] || { echo "no staged request at $STAGED" >&2; exit 1; }
    command -v step >/dev/null || { echo "step CLI is not installed" >&2; exit 1; }
    [ -s "$CA_PASS" ] || { echo "step-ca is not initialized on this appliance" >&2; exit 1; }
    NAME=$(sed -n 1p "$STAGED")
    valid_name "$NAME" || { echo "invalid certificate name" >&2; exit 1; }
    SANS=$(sed -n '2,$p' "$STAGED")
    [ -n "$SANS" ] || { echo "at least one SAN is required" >&2; exit 1; }
    SUBJECT=""
    SAN_ARGS=""
    for s in $SANS; do
      valid_san "$s" || { echo "invalid SAN: $s" >&2; exit 1; }
      [ -n "$SUBJECT" ] || SUBJECT="$s"
      SAN_ARGS="$SAN_ARGS --san $s"
    done
    install -d -m 0755 "$CERTDIR"
    # shellcheck disable=SC2086
    step ca certificate "$SUBJECT" "$CERTDIR/$NAME.crt" "$CERTDIR/$NAME.key" \
      --ca-url "$CA_URL" --root "$CA_ROOT" \
      --provisioner admin --provisioner-password-file "$CA_PASS" \
      --not-after 2160h --force $SAN_ARGS >/dev/null
    chmod 0644 "$CERTDIR/$NAME.crt"
    chown root:root "$CERTDIR/$NAME.crt" "$CERTDIR/$NAME.key"
    chmod 0600 "$CERTDIR/$NAME.key"
    logger -t saguaro-cert "issued certificate $NAME"
    ;;
  renew-all)
    command -v step >/dev/null || exit 0
    [ -d "$CERTDIR" ] || exit 0
    renewed=0
    for crt in "$CERTDIR"/*.crt; do
      [ -e "$crt" ] || break
      key="${crt%.crt}.key"
      if step ca renew --force "$crt" "$key" --ca-url "$CA_URL" --root "$CA_ROOT" >/dev/null 2>&1; then
        renewed=$((renewed+1))
      fi
    done
    [ "$renewed" -gt 0 ] && { nginx -t >/dev/null 2>&1 && systemctl reload nginx || true; }
    logger -t saguaro-cert "renewed $renewed certificate(s)"
    ;;
  acme)
    NAME="${2:-}"; DOMAIN="${3:-}"; EMAIL="${4:-}"
    valid_name "$NAME" || { echo "invalid certificate name" >&2; exit 1; }
    echo "$DOMAIN" | grep -Eq '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$' || { echo "invalid domain" >&2; exit 1; }
    echo "$EMAIL" | grep -Eq '^[^@ ]+@[^@ ]+\.[^@ ]+$' || { echo "invalid email" >&2; exit 1; }
    command -v certbot >/dev/null || { echo "certbot is not installed" >&2; exit 1; }
    install -d -m 0755 "$CERTDIR"
    install_acme_hooks
    open80
    ok=1
    certbot certonly --standalone --non-interactive --agree-tos --preferred-challenges http \
      --http-01-port 80 --cert-name "$NAME" -m "$EMAIL" -d "$DOMAIN" >/tmp/saguaro-certbot.log 2>&1 || ok=0
    close80
    [ "$ok" = 1 ] || { echo "certbot failed:" >&2; tail -n 15 /tmp/saguaro-certbot.log >&2; exit 1; }
    LIVE=/etc/letsencrypt/live/$NAME
    install -m 0644 -o root -g root "$LIVE/fullchain.pem" "$CERTDIR/$NAME.crt"
    install -m 0600 -o root -g root "$LIVE/privkey.pem" "$CERTDIR/$NAME.key"
    logger -t saguaro-cert "issued public certificate $NAME for $DOMAIN"
    ;;
  acme-dns)
    NAME="${2:-}"; DOMAIN="${3:-}"; EMAIL="${4:-}"
    valid_name "$NAME" || { echo "invalid certificate name" >&2; exit 1; }
    valid_acme_domain "$DOMAIN" || { echo "invalid domain" >&2; exit 1; }
    echo "$EMAIL" | grep -Eq '^[^@ ]+@[^@ ]+\.[^@ ]+$' || { echo "invalid email" >&2; exit 1; }
    command -v certbot >/dev/null || { echo "certbot is not installed" >&2; exit 1; }
    command -v pdnsutil >/dev/null || { echo "pdnsutil (PowerDNS) is required for DNS-01" >&2; exit 1; }
    # The zone must be hosted locally so the hooks can publish the TXT record.
    ZBASE=${DOMAIN#\*.}
    pdns_zone_for "$ZBASE" >/dev/null || { echo "no local PowerDNS zone is authoritative for $ZBASE" >&2; exit 1; }
    install -d -m 0755 "$CERTDIR"
    install_acme_hooks
    ok=1
    certbot certonly --manual --non-interactive --agree-tos --preferred-challenges dns \
      --manual-auth-hook "$SELF acme-auth-hook" --manual-cleanup-hook "$SELF acme-cleanup-hook" \
      --cert-name "$NAME" -m "$EMAIL" -d "$DOMAIN" >/tmp/saguaro-certbot.log 2>&1 || ok=0
    [ "$ok" = 1 ] || { echo "certbot failed:" >&2; tail -n 15 /tmp/saguaro-certbot.log >&2; exit 1; }
    LIVE=/etc/letsencrypt/live/$NAME
    install -m 0644 -o root -g root "$LIVE/fullchain.pem" "$CERTDIR/$NAME.crt"
    install -m 0600 -o root -g root "$LIVE/privkey.pem" "$CERTDIR/$NAME.key"
    logger -t saguaro-cert "issued public certificate $NAME for $DOMAIN via DNS-01"
    ;;
  acme-auth-hook)
    # Invoked by certbot (as root) during DNS-01. Publishes the challenge TXT.
    [ -n "${CERTBOT_DOMAIN:-}" ] && [ -n "${CERTBOT_VALIDATION:-}" ] || { echo "missing CERTBOT env" >&2; exit 1; }
    ZONE=$(pdns_zone_for "$CERTBOT_DOMAIN") || { echo "no local zone for $CERTBOT_DOMAIN" >&2; exit 1; }
    REC=$(rel_challenge "$CERTBOT_DOMAIN" "$ZONE")
    pdnsutil add-record "$ZONE" "$REC" TXT 60 "\"$CERTBOT_VALIDATION\"" >/dev/null 2>&1 \
      || { echo "failed to add challenge TXT" >&2; exit 1; }
    pdnsutil rectify-zone "$ZONE" >/dev/null 2>&1 || true
    command -v pdns_control >/dev/null 2>&1 && pdns_control purge "$REC.$ZONE." >/dev/null 2>&1 || true
    sleep 2
    ;;
  acme-cleanup-hook)
    [ -n "${CERTBOT_DOMAIN:-}" ] || exit 0
    ZONE=$(pdns_zone_for "$CERTBOT_DOMAIN") || exit 0
    REC=$(rel_challenge "$CERTBOT_DOMAIN" "$ZONE")
    pdnsutil delete-rrset "$ZONE" "$REC" TXT >/dev/null 2>&1 || true
    pdnsutil rectify-zone "$ZONE" >/dev/null 2>&1 || true
    ;;
  remove)
    NAME="${2:-}"
    valid_name "$NAME" || { echo "invalid certificate name" >&2; exit 1; }
    rm -f "$CERTDIR/$NAME.crt" "$CERTDIR/$NAME.key" "/etc/letsencrypt/renewal-hooks/deploy/saguaro-$NAME.sh"
    command -v certbot >/dev/null 2>&1 && certbot delete --cert-name "$NAME" --non-interactive >/dev/null 2>&1 || true
    nginx -t >/dev/null 2>&1 && systemctl reload nginx || true
    logger -t saguaro-cert "removed certificate $NAME"
    ;;
  deploy-gui)
    NAME="${2:-}"
    valid_name "$NAME" || { echo "invalid certificate name" >&2; exit 1; }
    [ -s "$CERTDIR/$NAME.crt" ] && [ -s "$CERTDIR/$NAME.key" ] || { echo "certificate $NAME not found" >&2; exit 1; }
    install -m 0644 -o root -g root "$CERTDIR/$NAME.crt" "$GUI_CRT"
    install -m 0600 -o root -g root "$CERTDIR/$NAME.key" "$GUI_KEY"
    nginx -t >/dev/null 2>&1 || { echo "nginx -t failed after deploy" >&2; exit 1; }
    systemctl reload nginx
    logger -t saguaro-cert "deployed certificate $NAME to the GUI vhost"
    ;;
  *)
    echo "usage: saguaro-cert issue | acme NAME DOMAIN EMAIL | acme-dns NAME DOMAIN EMAIL | renew-all | remove NAME | deploy-gui NAME" >&2
    exit 2
    ;;
esac
