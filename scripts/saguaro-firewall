#!/bin/sh
# saguaro-firewall — the root adapter for firewall changes (SNA spec: a
# root-owned tool exposing only validated, allow-listed operations; the
# saguaro user may run exactly this via sudoers).
#
#   check     validate the staged ruleset (nft -c)
#   apply     validate, back up, install and load the staged ruleset, then
#             schedule an automatic rollback in 120 s unless confirmed
#   confirm   keep the applied ruleset (cancels the pending rollback)
#   rollback  restore the previous ruleset immediately
#   rollback-if-pending  used by the timer; restores only when unconfirmed
set -eu

STAGED=/var/lib/saguaro/staged-nftables.conf
ACTIVE=/etc/nftables.conf
RUNDIR=/run/saguaro
BACKUP=$RUNDIR/nftables-backup.conf
FLAG=$RUNDIR/firewall-pending
TIMER_UNIT=saguaro-fw-rollback

[ "$(id -u)" = 0 ] || { echo "must run as root (via sudo)" >&2; exit 1; }
[ $# -eq 1 ] || { echo "usage: saguaro-firewall check|apply|confirm|rollback|rollback-if-pending|counters|log" >&2; exit 2; }

do_check() {
  [ -s "$STAGED" ] || { echo "no staged ruleset at $STAGED" >&2; exit 1; }
  nft -c -f "$STAGED"
}

enable_forwarding_if_needed() {
  if grep -q "saguaro-nat" "$ACTIVE"; then
    printf 'net.ipv4.ip_forward=1\n' >/etc/sysctl.d/99-saguaro-forward.conf
    sysctl -q -w net.ipv4.ip_forward=1
  fi
}

restore_backup() {
  if [ -s "$BACKUP" ]; then
    install -m 0644 -o root -g root "$BACKUP" "$ACTIVE"
    nft -f "$ACTIVE"
  else
    # No prior ruleset existed (first-ever apply). Reverting means removing the
    # rules we just added, not failing -- a hard exit here used to leave the
    # pending flag stuck forever, so the GUI kept showing "awaiting confirm"
    # with no timer left to resolve it and Confirm looked like it did nothing.
    printf '#!/usr/sbin/nft -f\nflush ruleset\n' > "$ACTIVE"
    nft flush ruleset
  fi
  # Always clear the pending flag so the state can never get stuck.
  rm -f "$FLAG"
  logger -t saguaro-firewall "nftables ruleset rolled back"
}

case "$1" in
  check)
    do_check
    ;;
  apply)
    do_check
    install -d -m 0755 "$RUNDIR"
    cp -p "$ACTIVE" "$BACKUP" 2>/dev/null || : >"$BACKUP"
    install -m 0644 -o root -g root "$STAGED" "$ACTIVE"
    # Validate and load the DESTINATION file, not the staged one, so a
    # staged-file swap between check and load cannot slip an unvalidated
    # ruleset past us (SR2). ACTIVE lives in /etc and saguaro cannot alter it.
    if ! nft -c -f "$ACTIVE"; then
      [ -s "$BACKUP" ] && install -m 0644 -o root -g root "$BACKUP" "$ACTIVE" || rm -f "$ACTIVE"
      echo "installed ruleset failed validation; previous state restored" >&2
      exit 1
    fi
    nft -f "$ACTIVE"
    enable_forwarding_if_needed
    # Make the ruleset survive a reboot. nftables.service loads /etc/nftables.conf
    # at boot but ships disabled on Ubuntu; without this the firewall and NAT
    # vanish after a restart (clients lose internet, box loses its filtering).
    # ACTIVE is exactly the file that unit loads, so enabling it is enough.
    systemctl enable nftables >/dev/null 2>&1 || true
    : >"$FLAG"
    systemctl stop "$TIMER_UNIT.timer" 2>/dev/null || true
    systemd-run --unit="$TIMER_UNIT" --on-active=120 --timer-property=AccuracySec=1s \
      /usr/sbin/saguaro-firewall rollback-if-pending >/dev/null 2>&1
    logger -t saguaro-firewall "new ruleset applied; auto-rollback in 120 s unless confirmed"
    ;;
  confirm)
    rm -f "$FLAG"
    systemctl stop "$TIMER_UNIT.timer" 2>/dev/null || true
    logger -t saguaro-firewall "ruleset confirmed"
    ;;
  counters)
    # Read-only: dump the live ruleset as JSON so the control plane can map each
    # rule's packet/byte counter to its rule (by the sna-rule: comment).
    nft -j list table inet saguaro 2>/dev/null || echo '{"nftables":[]}'
    ;;
  log)
    # Read-only: the most recent netfilter LOG lines the SNA rules emit (per-rule
    # "Log" flag, the block rule, and the catch-all drops), for the Log Viewer.
    journalctl -k -o short-iso --no-pager -n 8000 2>/dev/null | grep -E "SNA[:-]" | tail -300 || true
    ;;
  rollback)
    systemctl stop "$TIMER_UNIT.timer" 2>/dev/null || true
    restore_backup
    ;;
  rollback-if-pending)
    [ -e "$FLAG" ] || exit 0
    restore_backup
    ;;
  *)
    echo "unknown action" >&2
    exit 2
    ;;
esac
