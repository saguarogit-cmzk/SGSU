# Saguaro does not receive unrestricted sudo. Only the root firewall adapter
# is allowed — a fixed path with a fixed, validated set of subcommands
# (check/apply/confirm/rollback) and a 120 s confirm-or-rollback window.
# Do not add "saguaro ALL=(ALL) NOPASSWD: ALL" here.
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-firewall check, /usr/sbin/saguaro-firewall apply, /usr/sbin/saguaro-firewall confirm, /usr/sbin/saguaro-firewall rollback
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-ids apply ids, /usr/sbin/saguaro-ids apply ips, /usr/sbin/saguaro-ids disable, /usr/sbin/saguaro-ids update-rules
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-rpz apply, /usr/sbin/saguaro-rpz disable
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-proxy apply, /usr/sbin/saguaro-proxy disable
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-cert issue, /usr/sbin/saguaro-cert acme *, /usr/sbin/saguaro-cert renew-all, /usr/sbin/saguaro-cert remove *, /usr/sbin/saguaro-cert deploy-gui *
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-vpn apply, /usr/sbin/saguaro-vpn disable
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-s2s apply, /usr/sbin/saguaro-s2s disable
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-ipsec apply, /usr/sbin/saguaro-ipsec disable
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-svc statusall, /usr/sbin/saguaro-svc status *, /usr/sbin/saguaro-svc start *, /usr/sbin/saguaro-svc stop *, /usr/sbin/saguaro-svc restart *
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-pkg list, /usr/sbin/saguaro-pkg refresh, /usr/sbin/saguaro-pkg upgrade *, /usr/sbin/saguaro-pkg unattended-status, /usr/sbin/saguaro-pkg unattended-enable, /usr/sbin/saguaro-pkg unattended-disable
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-logs unbound-stats, /usr/sbin/saguaro-logs suricata-alerts *
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-tools ping *, /usr/sbin/saguaro-tools dns *, /usr/sbin/saguaro-tools trace *, /usr/sbin/saguaro-tools mtr *, /usr/sbin/saguaro-tools http *
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-webproxy apply *, /usr/sbin/saguaro-webproxy disable
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-backup-config apply, /usr/sbin/saguaro-backup-config run, /usr/sbin/saguaro-backup-config disable
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-wan apply, /usr/sbin/saguaro-wan disable
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-net identify *, /usr/sbin/saguaro-net wan-apply, /usr/sbin/saguaro-net vlan-apply
saguaro ALL=(root) NOPASSWD: /usr/sbin/saguaro-route apply, /usr/sbin/saguaro-route flush
