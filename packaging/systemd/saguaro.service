[Unit]
Description=Saguaro Network Manager control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=saguaro
Group=saguaro
EnvironmentFile=/etc/saguaro/saguaro.env
LoadCredential=admin-password:/etc/saguaro/bootstrap-admin-password
ExecStart=/usr/lib/saguaro/saguaro
Restart=on-failure
RestartSec=3
# NoNewPrivileges and ProtectSystem=strict are intentionally NOT set: the
# control plane must sudo to the root adapters (/usr/sbin/saguaro-*), and those
# adapters — running in this unit's namespace — must write /etc. Containment is
# provided by the unprivileged saguaro user, the tightly scoped sudoers
# allow-list and the adapters' own input validation. ProtectSystem=true still
# keeps /usr and /boot read-only.
PrivateTmp=true
PrivateDevices=true
ProtectSystem=true
ProtectHome=true
# AF_NETLINK is how the kernel is asked about interfaces and routes. Without it
# `ip` dies with "Cannot open netlink socket" and every read of the live network
# state comes back empty -- the interface list, the addresses shown against each
# port, and the WAN uplinks detected from the routing table all silently render
# as "unavailable" rather than reporting an error. Netlink here is read-only in
# practice: changing the network goes through the root adapters, not this unit.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
